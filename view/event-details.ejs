<%- include('partials/header') %><article class="detail"><p class="eyebrow"><%= new Date(event.data_hora).toLocaleString('pt-BR') %></p><h1><%= event.titulo %></h1><p class="lead"><%= event.descricao %></p><dl><dt>Local</dt><dd><%= event.local %></dd><dt>Organização</dt><dd><%= event.organizador %></dd><dt>Vagas</dt><dd><%= event.vagas %></dd></dl><% if (user?.role !== 'organizador') { %><% if (enrolled) { %><p class="alert success">Você já está inscrito neste evento.</p><% } else if (user) { %><form action="/events/<%= event.id %>/enroll" method="post"><button>Fazer inscrição</button></form><% } else { %><a class="button" href="/auth/login">Entre para se inscrever</a><% } %><% } %></article><%- include('partials/footer') %>
