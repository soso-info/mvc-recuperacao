<%- include('partials/header') %>
<section class="form-card wide">
  <h1><%= title %></h1>
  <form action="<%= action %>" method="post">
    <label
      >Título<input
        name="titulo"
        required
        minlength="3"
        value="<%= event.titulo || '' %>" /></label
    ><label
      >Descrição<textarea name="descricao" required minlength="10">
<%= event.descricao || '' %></textarea></label
    ><label
      >Local<input
        name="local"
        required
        value="<%= event.local || '' %>" /></label
    ><label
      >Data e hora<input
        name="data_hora"
        type="datetime-local"
        required
        value="<%= event.data_hora ? new Date(event.data_hora).toISOString().slice(0,16) : '' %>" /></label
    ><label
      >Vagas<input
        name="vagas"
        type="number"
        min="1"
        max="10000"
        required
        value="<%= event.vagas || 30 %>" /></label
    ><button>Salvar evento</button>
  </form>
</section>
<%- include('partials/footer') %>
