<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | EventHub</title><link rel="stylesheet" href="/css/style.css"></head><body><header><a class="brand" href="/">EventHub</a><nav><a href="/">Eventos</a><% if (user?.role === 'organizador') { %><a href="/organizer/events">Meus eventos</a><% } %><% if (user) { %><span>Olá, <%= user.nome %></span><form action="/auth/logout" method="post"><button class="link">Sair</button></form><% } else { %><a href="/auth/login">Entrar</a><a class="button small" href="/auth/register">Criar conta</a><% } %></nav></header><main><% if (success?.length) { %><div class="alert success"><%= success[0] %></div><% } %><% if (error?.length) { %><div class="alert error"><%= error[0] %></div><% } %>
